extends SceneTree
const Rules = preload("res://scripts/systems/build_rules.gd")
func _initialize() -> void:
 call_deferred("_test")
func _test() -> void:
 assert(Rules.CATALOG.size() == 4)
 assert(Rules.size_of(true) == 2)
 assert(Rules.can_place(Vector2i(10,10),{"2,2":true},"warehouse"))
 assert(not Rules.can_place(Vector2i(3,3),{"2,2":true},"shed"))
 assert(not Rules.can_place(Vector2i(14,14),{},"complex"))
 assert(not Rules.can_place(Vector2i(7,4),{},"workshop"))
 assert(not Rules.can_place(Vector2i(10,6),{},"complex"))
 assert(not Rules.can_place(Vector2i(11,11),{"11,11":"workshop"},"shed"))
 assert(not Rules.can_place(Vector2i(11,11),{"10,10":"complex"},"shed"))
 assert(not Rules.can_place(Vector2i(10,10),{},"invalid"))
 var scene = load("res://scenes/Main.tscn").instantiate()
 root.add_child(scene)
 await process_frame
 scene._new()
 scene._start_build("shed")
 assert(scene.build)
 scene._build(Vector2i(10,10))
 assert(scene.cash == 1750)
 assert(scene.structures["10,10"] == "shed")
 assert(not scene.build)
 scene._start_build("workshop")
 scene._build(Vector2i(11,10))
 assert(scene.cash == 1750)
 assert(scene.build)
 scene._cancel_build()
 assert(not scene.build)
 scene._save()
 scene.structures.clear()
 scene._load()
 assert(scene.structures["10,10"] == "shed")
 assert(scene.structures["2,2"] == true)
 scene.cash = 5000
 scene._start_build("complex")
 scene._build(Vector2i(10,10))
 assert(scene.cash == 5000)
 scene._build(Vector2i(10,0))
 assert(scene.cash == 2000)
 assert(scene.structures["10,0"] == "complex")
 print("CONSTRUCTION_TEST_PASS")
 quit()
