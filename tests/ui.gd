extends SceneTree
func _initialize() -> void:
 call_deferred("_test")
func _test() -> void:
 var scene = load("res://scenes/Main.tscn").instantiate()
 root.add_child(scene)
 await process_frame
 assert(scene.game_ui != null)
 assert(scene.game_ui.menu_overlay.visible)
 assert(scene.game_ui.action_buttons.size() == 6)
 assert(scene.game_ui.menu_buttons.size() == 4)
 scene.game_ui.action_requested.emit("new")
 assert(scene.running)
 assert(not scene.game_ui.menu_overlay.visible)
 scene.game_ui.action_requested.emit("sow")
 assert(scene.cash == 1900)
 assert(scene.job == "sow")
 scene.game_ui.update_hud(scene.day,scene.cash,scene.grain,scene.stage,scene.job,scene.progress,false)
 assert(scene.game_ui.action_buttons["sow"].disabled)
 assert(scene.game_ui.action_buttons["harvest"].disabled)
 scene.game_ui.action_requested.emit("save")
 assert(FileAccess.file_exists(scene.SAVE))
 scene.game_ui.action_requested.emit("menu")
 assert(not scene.running)
 assert(scene.game_ui.menu_overlay.visible)
 scene.game_ui.action_requested.emit("continue")
 assert(scene.running)
 assert(scene.cash == 1900)
 print("UI_TEST_PASS")
 quit()
