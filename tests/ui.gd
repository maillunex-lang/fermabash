extends SceneTree
func _initialize() -> void:
 call_deferred("_test")
func _test() -> void:
 var scene = load("res://scenes/Main.tscn").instantiate()
 root.add_child(scene)
 await process_frame
 assert(scene.game_ui != null)
 assert(scene.game_ui.menu_overlay.visible)
 assert(scene.game_ui.action_buttons.size() == 20)
 assert(scene.game_ui.menu_buttons.size() == 4)
 scene.game_ui.action_requested.emit("new")
 assert(scene.onboarding.overlay.visible)
 scene.onboarding.name_input.text = "Тестовая ферма"
 scene.onboarding.district_select.select(1)
 scene.onboarding._district_changed(1)
 scene.onboarding._choose(Vector2i(2,2))
 scene.onboarding._confirm()
 assert(scene.running)
 assert(not scene.game_ui.menu_overlay.visible)
 scene.game_ui.action_requested.emit("prepare")
 assert(scene.pending_field_action == "prepare")
 assert(scene.cash == 2000)
 scene.pending_field_action = ""
 scene._job("prepare")
 assert(scene.cash == 1940)
 assert(scene.job == "prepare")
 scene.game_ui.update_hud(scene.day,scene.cash,scene.grain,scene.stage,scene.job,scene.progress,false)
 assert(not scene.game_ui.action_buttons["prepare"].disabled)
 assert(not scene.game_ui.action_buttons["harvest"].disabled)
 scene.game_ui.action_requested.emit("save")
 assert(FileAccess.file_exists(scene.SAVE))
 scene.game_ui.action_requested.emit("menu")
 assert(not scene.running)
 assert(scene.game_ui.menu_overlay.visible)
 scene.game_ui.action_requested.emit("continue")
 assert(scene.running)
 assert(scene.cash == 1940)
 print("UI_TEST_PASS")
 quit()
