extends SceneTree
const Catalog = preload("res://scripts/systems/beta_city_catalog.gd")
func _initialize() -> void:
 call_deferred("_test")
func _test() -> void:
 assert(Catalog.valid())
 assert(Catalog.CITIES.size() == 8)
 assert(Catalog.CITIES.size() <= Catalog.MAX_BETA_CITIES)
 assert(Catalog.city("ufa")["name"] == "Уфа")
 assert(Catalog.city("nonexistent").is_empty())
 for item in Catalog.CITIES:
  var p: Vector2 = Catalog.normalized(item)
  assert(p.x >= 0.0 and p.x <= 1.0)
  assert(p.y >= 0.0 and p.y <= 1.0)
 var scene = load("res://scenes/Main.tscn").instantiate()
 root.add_child(scene)
 await process_frame
 scene._new()
 var before: Dictionary = scene._snapshot()
 scene._ui_action("region_map")
 assert(scene.game_ui.region_overlay.visible)
 assert(scene.game_ui.city_map != null)
 assert(scene.game_ui.city_map.buttons.size() == 8)
 assert(scene.game_ui.city_buttons.size() == 8)
 assert(scene.game_ui.city_scroll != null)
 scene.game_ui.city_map._select("ufa")
 assert(scene.game_ui.city_details.text.contains("Уфа"))
 assert(scene.game_ui.city_buttons["ufa"].disabled)
 assert(not scene.game_ui.city_buttons["birsk"].disabled)
 scene.game_ui.city_buttons["birsk"].pressed.emit()
 assert(scene.game_ui.city_map.selected_id == "birsk")
 assert(scene.game_ui.city_buttons["birsk"].disabled)
 scene._ui_action("region_district_list")
 assert(scene.game_ui.region_title.text.contains("РАЙОНЫ"))
 scene._ui_action("region_back")
 assert(scene.game_ui.city_map != null)
 scene._ui_action("region_close")
 assert(not scene.game_ui.region_overlay.visible)
 assert(scene._snapshot() == before)
 print("BETA_CITY_MAP_TEST_PASS")
 quit()
