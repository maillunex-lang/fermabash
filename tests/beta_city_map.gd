extends SceneTree
const Registry = preload("res://scripts/systems/farm_registry.gd")
func _initialize() -> void:
 call_deferred("_test")
func _test() -> void:
 assert(Registry.DISTRICTS.size() == 2)
 assert(Registry.district("unknown").is_empty())
 assert(Registry.valid_name("КФХ Рассвет"))
 assert(not Registry.valid_name("а"))
 assert(Registry.plot_free(Vector2i(3,4),[]))
 assert(not Registry.plot_free(Vector2i(11,11),[]))
 assert(not Registry.plot_free(Vector2i(4,4),[Vector2i(3,4)]))
 var profile: Dictionary = Registry.create("КФХ Рассвет","ufimsky",Vector2i(3,4))
 assert(Registry.validate(profile))
 assert(Registry.create("КФХ Рассвет","ufimsky",Vector2i(4,4),[Vector2i(3,4)]).is_empty())
 var scene = load("res://scenes/Main.tscn").instantiate()
 root.add_child(scene)
 await process_frame
 scene._ui_action("new")
 assert(scene.onboarding.overlay.visible)
 assert(not scene.running)
 scene.onboarding.name_input.text = "КФХ Рассвет"
 scene.onboarding.district_select.select(1)
 scene.onboarding._district_changed(1)
 scene.onboarding._choose(Vector2i(3,4))
 scene.onboarding._confirm()
 assert(scene.running)
 assert(not scene.onboarding.overlay.visible)
 assert(scene.farm_profile == profile)
 scene._save()
 scene.farm_profile.clear()
 scene._load()
 assert(scene.farm_profile == profile)
 print("FARM_ONBOARDING_TEST_PASS")
 quit()
