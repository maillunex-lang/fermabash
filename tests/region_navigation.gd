extends SceneTree
const Catalog = preload("res://scripts/systems/region_catalog.gd")
func _initialize() -> void:
 call_deferred("_test")
func _test() -> void:
 assert(Catalog.DISTRICTS.size() == 2)
 assert(Catalog.district("ufa")["name"] == "Уфимский район")
 assert(Catalog.settlement("ufa","mikhailovka")["name"] == "Михайловка")
 assert(Catalog.settlement("ufa","unknown").is_empty())
 var scene = load("res://scenes/Main.tscn").instantiate()
 root.add_child(scene)
 await process_frame
 scene._new()
 var before: Dictionary = scene._snapshot()
 scene._ui_action("region_map")
 assert(scene.game_ui.region_overlay.visible)
 scene._ui_action("region_district:ufa")
 assert(scene.game_ui.region_selected == "ufa")
 scene._ui_action("region_settlement:ufa:mikhailovka")
 assert(scene.game_ui.region_title.text.contains("Михайловка"))
 scene._ui_action("region_close")
 assert(not scene.game_ui.region_overlay.visible)
 assert(scene._snapshot() == before)
 print("REGION_NAVIGATION_TEST_PASS")
 quit()
