extends SceneTree
const Registry = preload("res://scripts/systems/farm_registry.gd")
func _initialize() -> void:
 call_deferred("_test")
func _test() -> void:
 assert(Registry.DISTRICTS.size() == 2)
 assert(Registry.district("ufimsky")["name"] == "Уфимский район")
 var scene = load("res://scenes/Main.tscn").instantiate()
 root.add_child(scene)
 await process_frame
 scene._new()
 scene.farm_profile = Registry.create("Ферма Рассвет","ufimsky",Vector2i(3,4))
 var before: Dictionary = scene._snapshot()
 scene._ui_action("region_map")
 assert(scene.game_ui.region_overlay.visible)
 scene._ui_action("region_district:ufimsky")
 assert(scene.game_ui.region_selected == "ufimsky")
 assert(scene.game_ui.region_title.text.contains("УФИМСКИЙ"))
 scene._ui_action("region_back")
 assert(scene.game_ui.region_title.text.contains("РАЙОНЫ"))
 scene._ui_action("region_close")
 assert(not scene.game_ui.region_overlay.visible)
 assert(scene._snapshot() == before)
 print("REGION_NAVIGATION_TEST_PASS")
 quit()
