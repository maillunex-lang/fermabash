extends SceneTree
const Route = preload("res://scripts/systems/field_route.gd")
const LivingField = preload("res://scripts/visuals/living_field.gd")
func _initialize() -> void:
 call_deferred("_test")
func _test() -> void:
 var points := Route.waypoints()
 assert(points.size() == 12)
 assert(Route.position_at(0).distance_to(points[0]) < 0.001)
 assert(Route.position_at(1).distance_to(points[-1]) < 0.001)
 for i in range(101):
  var p := Route.position_at(float(i)/100.0)
  assert(p.x >= Route.MIN_X and p.x <= Route.MAX_X)
  assert(p.z >= Route.MIN_Z and p.z <= Route.MAX_Z)
 assert(not Route.completed_fraction(0.0,5,3))
 assert(Route.completed_fraction(1.0,8,6))
 var field := LivingField.new()
 root.add_child(field)
 field.update_field(0,false,"prepare",0.0)
 assert(field.soil.multimesh.instance_count == 16)
 assert(field.crops.multimesh.instance_count == 320)
 var start_color := field.soil.multimesh.get_instance_color(0)
 field.update_field(0,false,"prepare",0.9)
 assert(field.soil.multimesh.get_instance_color(0) != start_color)
 field.update_field(1,false,"",0.5)
 assert(field.crops.multimesh.get_instance_color(0).g > 0.0)
 field.update_field(2,false,"harvest",1.0)
 assert(field.crops.multimesh.get_instance_color(0).a == 0.0)
 var scene = load("res://scenes/Main.tscn").instantiate()
 root.add_child(scene)
 await process_frame
 scene._new()
 scene._job("prepare")
 scene._process(1.5)
 assert(scene.tractor.position.distance_to(Route.position_at(scene.progress)) < 0.001)
 scene._save()
 scene._load()
 assert(scene.tractor.position.distance_to(Route.position_at(scene.progress)) < 0.001)
 print("LIVING_FIELD_TEST_PASS")
 quit()
