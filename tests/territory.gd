extends SceneTree
const Territory = preload("res://scripts/systems/territory_rules.gd")
func _initialize() -> void:
 call_deferred("_test")
func _test() -> void:
 assert(Territory.can_buy(Vector2i(16,8),{}))
 assert(not Territory.can_buy(Vector2i(19,19),{}))
 assert(not Territory.can_buy(Vector2i(15,8),{}))
 assert(Territory.road_multiplier("asphalt") > Territory.road_multiplier("gravel"))
 assert(Territory.road_multiplier("gravel") > Territory.road_multiplier("dirt"))
 var scene = load("res://scenes/Main.tscn").instantiate()
 root.add_child(scene)
 await process_frame
 scene._new()
 scene._start_territory("land")
 assert(scene._develop(Vector2i(16,8)))
 assert(scene.cash == 1900)
 assert(scene._develop(Vector2i(17,8)))
 assert(scene.cash == 1800)
 assert(not scene._develop(Vector2i(23,23)))
 scene._start_territory("road_gravel")
 assert(scene._develop(Vector2i(16,8)))
 assert(scene.cash == 1700)
 assert(scene._develop(Vector2i(17,8)))
 assert(scene.cash == 1600)
 assert(not scene._develop(Vector2i(16,8)))
 assert(scene._road_speed_at(Vector2i(16,8)) == 1.5)
 scene._road_patrol(0.5)
 assert(scene.road_vehicle_progress > 0.0)
 scene._start_territory("field")
 assert(not scene._develop(Vector2i(16,8)))
 assert(scene._develop(Vector2i(16,9)) == false)
 scene._start_territory("land")
 assert(scene._develop(Vector2i(16,9)))
 scene._start_territory("field")
 assert(scene._develop(Vector2i(16,9)))
 assert(scene.cash == 1420)
 assert(Territory.valid_layout(scene.extra_land,scene.field_plots,scene.roads))
 scene._save()
 var expected: Dictionary = scene._snapshot()
 scene.extra_land.clear()
 scene.field_plots.clear()
 scene.roads.clear()
 scene._load()
 assert(scene._snapshot()["extra_land"] == expected["extra_land"])
 assert(scene._snapshot()["field_plots"] == expected["field_plots"])
 assert(scene._snapshot()["roads"] == expected["roads"])
 assert(Territory.valid_layout(scene.extra_land,scene.field_plots,scene.roads))
 print("TERRITORY_TEST_PASS")
 quit()
